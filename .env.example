# Stripe API Keys (Get these from https://dashboard.stripe.com/apikeys)
# For production, use keys starting with sk_live_
STRIPE_SECRET_KEY=sk_test_51...

# App URL (Used for Checkout success/cancel redirects)
# Production: https://your-app-domain.com
# Local: http://localhost:3000
BASE_URL=http://localhost:3000

# PDF Server URL (For Web -> PDF Server communication)
PDF_SERVER_URL=http://localhost:3001/generate
PDF_SERVER_API_KEY=your_secret_api_key_here

# Used by deploy.sh to authenticate between Web and PDF server
# Set this in your shell before running deploy.sh:
#   export PDF_SERVER_API_KEY=your_secret_api_key_here
