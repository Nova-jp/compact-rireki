# Stripe API Keys（https://dashboard.stripe.com/apikeys）
# 本番: sk_live_ で始まるキー
STRIPE_SECRET_KEY=sk_test_51...

# App URL（リダイレクト先）
# ローカル: http://localhost:3000
# 本番: https://compact-rireki.com
BASE_URL=http://localhost:3000

# Web → PDF サーバー間の通信
# ローカルではコードのデフォルト値（localhost:3001）を使うため省略可
PDF_SERVER_URL=http://localhost:3001/generate
PDF_SERVER_API_KEY=your_secret_api_key_here

# Stripe Webhook 署名検証（本番・ローカルのWebhookテスト時に必要）
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Analytics（公開情報。ビルド時にJSバンドルに埋め込まれる）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
